<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="classora" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.classora.model.AppUser</class>
        <class>com.classora.model.Student</class>
        <class>com.classora.model.Quiz</class>
        <class>com.classora.model.Question</class>
        <class>com.classora.model.QuizOption</class>
        <class>com.classora.model.QuizAttempt</class>
        <class>com.classora.model.AttemptAnswer</class>
        <class>com.classora.model.Person</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
    </persistence-unit>
</persistence>
